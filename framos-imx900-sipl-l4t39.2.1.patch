+#ifndef UDDF_SAMPLES_IMX900SENSORDRIVER_HPP
+#define UDDF_SAMPLES_IMX900SENSORDRIVER_HPP
+
+#include "uddf/cdi/IHardwareAccess.hpp"
+#include "uddf/ddi/interfaces/ICameraSensorControl.hpp"
+#include "uddf/ddi/interfaces/ICameraSensorInfo.hpp"
+#include "uddf/ddi/interfaces/ISensorCharMode.hpp"
+
+namespace uddf::samples {
+
+using namespace uddf::ddi::interfaces;
+
+class IMX900SensorDriver final : public ICameraSensorControl,
+                                 public ICameraSensorInfo,
+                                 public uddf::ddi::interfaces::ISensorCharMode {
+public:
+    explicit IMX900SensorDriver();
+    ~IMX900SensorDriver() override;
+
+    // --- ISensorCharMode Methods ---
+
+    bool SetSensorCharMode(uddf::cdi::IHardwareAccess& hwAccess,
+                           uddf::cdi::IDriverServices& driverServices,
+                           uint8_t exposureNumber) override;
+
+    /**
+     * @brief Select the frame timing for the resolution SIPL configured.
+     *
+     * Exposure is SHS = VMAX - lines, so VMAX has to match the mode table
+     * Init programs or every exposure is wrong by the ratio of the two.
+     */
+    /** @brief Which sensor variant a mode requires. */
+    enum class Variant { Any, Colour, Mono };
+
+    /** @brief Select the mode timing; false if the driver has no such mode. */
+    bool SetMode(uint32_t width, uint32_t height, float fps);
+
+    /** @brief Write the VMAX SetMode derived from the fps. After the mode table. */
+    void ApplyFrameLength(uddf::cdi::IHardwareAccess& hwAccess) const;
+
+    /** @brief Variant the mode selected by SetMode needs. */
+    Variant ModeVariant() const { return m_variant; }
+
+    /** @brief Conversion gain (FDG_SEL). High lifts the gain floor to 3 dB. */
+    enum class ConversionGain { Low, High };
+
+    /** @brief Set before SIPL reads GetSensorAttributes: it moves the gain range. */
+    void SetConversionGain(ConversionGain conversionGain) { m_conversionGain = conversionGain; }
+    ConversionGain GetConversionGain() const { return m_conversionGain; }
+
+    // --- ICameraSensorControl Methods ---
+
+    bool SetSensorControls(uddf::cdi::IHardwareAccess& hwAccess,
+                           uddf::cdi::IDriverServices& driverServices,
+                           const SensorControls& controls) override;
+
+    // --- ICameraSensorInfo Methods ---
+
+    bool GetSensorAttributes(uddf::cdi::IDriverServices& driverServices,
+                             SensorAttributes& attributes) const override;
+
+    bool ParseTopEmbeddedData(uddf::cdi::IDriverServices& driverServices,
+                              const EmbeddedDataChunk& chunk,
+                              EmbeddedDataInfo& info) override;
+
+    bool ParseBottomEmbeddedData(uddf::cdi::IDriverServices& driverServices,
+                                 const EmbeddedDataChunk& chunk,
+                                 EmbeddedDataInfo& info) override;
+
+private:
+    bool SetGain(uddf::cdi::IHardwareAccess& hwAccess,
+                 uddf::cdi::IDriverServices& driverServices,
+                 const sensor_control::ExposureGainInfo& exposureGainControl);
+    bool SetExposure(uddf::cdi::IHardwareAccess& hwAccess,
+                     uddf::cdi::IDriverServices& driverServices,
+                     const sensor_control::ExposureGainInfo& exposureGainControl);
+
+    // VMAX of the active mode; set by SetMode, defaults to the full frame.
+    uint32_t m_hmax { 610U };
+    uint32_t m_vmax { 1689U };
+    uint32_t m_minShs { 51U };
+    Variant m_variant { Variant::Any };
+
+    // Derived from m_hmax; recomputed by SetMode.
+    float m_lineTimeNs { 0.0f };
+    float m_minExposure { 0.0f };
+
+    // Bayer phase of the active mode; set by SetMode with the timing.
+    sensor_control::PixelOrder m_cfa { sensor_control::PixelOrder::RGGB };
+
+    // Derived from m_vmax; recomputed by SetMode so the two cannot diverge.
+    float m_maxExposure { 0.0f };
+
+    bool m_charModeEnabled { false };
+
+    ConversionGain m_conversionGain { ConversionGain::Low };
+
+    /** @brief Lowest gain the sensor accepts in the current conversion gain. */
+    float GainMin() const;
+
+    mutable uint64_t m_artificialFrameCounter { 0 };
+};
+
+} // namespace uddf::samples
