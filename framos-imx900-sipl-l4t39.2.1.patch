+#ifndef UDDF_SAMPLES_IMX900MODULEDRIVER_HPP
+#define UDDF_SAMPLES_IMX900MODULEDRIVER_HPP
+
+#include "CoEModuleDriverBase.hpp"
+#include "uddf/cdi/IHardwareAccess.hpp"
+#include "uddf/ddi/interfaces/ICameraSensorControl.hpp"
+#include "uddf/ddi/interfaces/ICameraSensorInfo.hpp"
+#include "IMX900SensorDriver.hpp"
+
+#include <string_view>
+
+namespace uddf::samples {
+
+using namespace uddf::ddi::interfaces;
+
+class IMX900ModuleDriver final : public CoEModuleDriverBase {
+public:
+    /**
+     * @brief The I2C devices this module's HSL sequences touch, with the
+     *        register-offset width each one needs.
+     *
+     * Single source of truth: ConfigureDriver() hands this to the framework,
+     * and the module library hands the same table to the transport (see
+     * HsbOffsetWidthTransport) because the framework does not forward the
+     * widths itself. Must match the I2CDevice declarations in fr_imx900_hsl.py.
+     */
+    static const uddf::ddi::DeviceTable& GetDeviceTable() noexcept;
+
+    /** @brief Exposure start: internal timing, or an XTRIG pulse (FRAMOS shutter mode). */
+    enum class TriggerMode { Normal, Sequential, Fast };
+
+    explicit IMX900ModuleDriver();
+    ~IMX900ModuleDriver() override;
+
+    // --- ICameraModule Methods ---
+
+    ICameraSensorControl* GetSensorControl(const CameraModuleContext& context, size_t index) override;
+    ICameraSensorInfo* GetCameraSensorInfo(const CameraModuleContext& context, size_t index) override;
+    bool StartStreaming(const CameraModuleContext& context) override;
+    bool StopStreaming(const CameraModuleContext& context) override;
+
+    // --- ICoEModuleControl Methods ---
+
+    bool ConfigureDriver(const CoEModuleContext& context, uddf::ddi::DeviceTable& deviceTable) override;
+    bool ProbeHardware(const CoEModuleContext& context) override;
+    bool Init(const CoEModuleContext& context) override;
+    bool Deinit(const CoEModuleContext& context) override;
+    bool Reset(const CoEModuleContext& context) override;
+
+protected:
+    /** @brief Expose ISensorCharMode; the base class does not aggregate it. */
+    uddf::ddi::IInterface* GetExtendedInterface(const uddf::ddi::UUID& uuid) noexcept override;
+
+    IMX900SensorDriver m_sensorDriver;
+
+private:
+    void LogState(std::string_view label, uddf::cdi::IHardwareAccess& hwAccess);
+
+    /** @brief Power the sensor and read 0x3817; true when a mono part is fitted. */
+    bool ProbeChromacity(uddf::cdi::IHardwareAccess& hwAccess);
+    bool m_is_streaming;
+
+    // Resolution SIPL configured; set in ConfigureDriver, read by Init.
+    uint32_t m_width { 2048U };
+    uint32_t m_height { 1552U };
+
+    bool m_isMono { false };
+
+    // sensorGroup > 0 in the config marks the target (J6 in IMX900_DUAL_SYNC);
+    // CoEModuleContext names no port, isStereo is the only per-camera flag.
+    bool m_isStereo { false };
+    // Set in Init from m_isStereo: follows the other sensor's XVS/XHS.
+    bool m_isTarget { false };
+
+    // Set in ConfigureDriver; checked against the role there.
+    TriggerMode m_triggerMode { TriggerMode::Normal };
+};
+
+} // namespace uddf::samples
+
+#endif // UDDF_SAMPLES_IMX900MODULEDRIVER_HPP
