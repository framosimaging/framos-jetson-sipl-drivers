+
+void IMX900ModuleDriver::LogState(std::string_view label, uddf::cdi::IHardwareAccess& hwAccess) {
+    uint8_t standby_state {};
+    hwAccess.ReadI2C(fr_imx900::hsl::CAM_I2C_ADDRESS, 0x3000U, 1U, &standby_state);
+    log(label, " standby=0x", std::hex, static_cast<uint16_t>(standby_state));
+}
+
+uddf::ddi::IInterface*
+IMX900ModuleDriver::GetExtendedInterface(const uddf::ddi::UUID& uuid) noexcept {
+    if (uuid == uddf::ddi::interfaces::ISensorCharMode::id) {
+        return static_cast<uddf::ddi::interfaces::ISensorCharMode*>(&m_sensorDriver);
+    }
+    return nullptr;
+}
+
+// 0x3817 bit 7: 0 = colour, 1 = mono.
+bool IMX900ModuleDriver::ProbeChromacity(uddf::cdi::IHardwareAccess& hwAccess) {
+    hwAccess.SubmitSequence(fr_imx900::hsl::bringup);
+    hwAccess.SubmitSequence(fr_imx900::hsl::wake);
+    std::this_thread::sleep_for(std::chrono::milliseconds(CHROMACITY_SETTLE_MS));
+
+    uint8_t chromacity {};
+    hwAccess.ReadI2C(fr_imx900::hsl::CAM_I2C_ADDRESS,
+                     IMX900_CHROMACITY_REG, 1U, &chromacity);
+    hwAccess.SubmitSequence(fr_imx900::hsl::standby);
+
+    const bool isMono = ((chromacity & 0x80U) != 0U);
+    log("chromacity reg = 0x", std::hex, static_cast<uint16_t>(chromacity), std::dec,
+        " -> ", (isMono ? "MONO" : "COLOUR"), " sensor");
+    return isMono;
+}
