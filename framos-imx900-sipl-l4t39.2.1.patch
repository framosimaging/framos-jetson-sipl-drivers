+IMX900ModuleDriver::GetCameraSensorInfo(const CameraModuleContext& context,
+                                        size_t index) {
+    log("GetCameraSensorInfo called for index: ", index, ".");
+    if (index == 0) {
+        return static_cast<ICameraSensorInfo*>(&m_sensorDriver);
+    }
+    return nullptr;
+}
