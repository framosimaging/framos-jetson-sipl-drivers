+bool IMX900ModuleDriver::StartStreaming(const CameraModuleContext& context) {
+    LogState("StartStreaming called", *context.hwAccess);
+    // XMSTA=0 on a target would start its own timing against the controller's.
+    if (m_isTarget) {
+        context.hwAccess->SubmitSequence(fr_imx900::hsl::start_target);
+    } else {
+        context.hwAccess->SubmitSequence(fr_imx900::hsl::start);
+    }
+    m_is_streaming = true;
+    return true;
+}
+
+bool IMX900ModuleDriver::StopStreaming(const CameraModuleContext& context) {
+    LogState("StopStreaming called", *context.hwAccess);
+    context.hwAccess->SubmitSequence(fr_imx900::hsl::stop);
+    m_is_streaming = false;
+    return true;
+}
