+uint8_t HsbTransportDriver::GetDeviceOffsetWidth(uint16_t address) const noexcept
+{
+    const auto it = m_deviceOffsetWidth.find(address);
+    return (it != m_deviceOffsetWidth.end()) ? it->second : DEFAULT_OFFSET_WIDTH;
+}
+
+void HsbTransportDriver::AppendOffsetBytes(std::vector<uint8_t>& writeBytes, uint16_t address,
+                                           uint16_t offset) const
+{
+    if (GetDeviceOffsetWidth(address) == 1U) {
+        writeBytes.push_back(offset & 0xFF);            // 8-bit register pointer
+    } else {
+        writeBytes.push_back((offset >> 8) & 0xFF);     // High byte first
+        writeBytes.push_back(offset & 0xFF);            // Low byte
+    }
+}
