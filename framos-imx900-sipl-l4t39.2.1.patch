+const uddf::ddi::DeviceTable& IMX900ModuleDriver::GetDeviceTable() noexcept {
+    // The 0x70 mux and 0x20 IO expander latch a single command byte, so both
+    // are declared 1-byte. At 2 bytes their register pointer came out as the
+    // high half of the offset (always 0x00, the read-only Input Port) and every
+    // write to them was silently dropped - see fr_imx900_hsl.py.
+    static const uddf::ddi::DeviceTable table {
+        {fr_imx900::hsl::CAM_I2C_ADDRESS, 2, 1, 0},   // sensor (0x1A), 16-bit registers
+        {fr_imx900::hsl::I2C_EXPANDER_I2C_ADDRESS, 1, 1, 0},  // I2C mux (0x70), one command byte
+        {fr_imx900::hsl::GPIO_EXPANDER_I2C_ADDRESS, 1, 1, 0}, // IO expander (0x20), one command byte
+    };
+    return table;
+}
+
+bool IMX900ModuleDriver::ConfigureDriver(const CoEModuleContext& context, uddf::ddi::DeviceTable& deviceTable) {
+    bool have_valid_configuration {true};
+
+    log("ConfigureDriver called: CoE configuration (IP: ",
+        context.config.ip, ", MAC: ", context.config.mac,
+        ", width: ", context.config.width, ", height: ", context.config.height,
+        ", frameRate: ", context.config.frameRate, ", pixelFormat: ", context.config.pixelFormat, ")");
+
+    // Remember the resolution so Init picks the matching mode table, and give
+    // the sensor driver its timing now: SIPL reads GetSensorAttributes before
+    // Init runs, so setting it there would advertise the wrong exposure range.
+    m_width = context.config.width;
+    m_height = context.config.height;
+    m_isStereo = context.config.isStereo;
+
+    // The chromacity cannot be probed here since context.hwAccess is null.
+    // Refusing a size here, before any hardware access, keeps an unsupported
+    // mode from being programmed with the full-frame table.
+    if (!m_sensorDriver.SetMode(m_width, m_height, context.config.frameRate)) {
+        have_valid_configuration = false;
+    }
+
+    // Here, not in Init: HCG lifts the gain floor SIPL reads from the attributes.
+    if (const auto conversionGain = ConversionGainSetting()) {
+        m_sensorDriver.SetConversionGain(*conversionGain);
+        log("  conversion gain ", (*conversionGain == ConversionGain::High) ? "HIGH" : "LOW");
+    } else {
+        log("  ERROR: IMX900_CONVERSION_GAIN=\"", std::getenv("IMX900_CONVERSION_GAIN"),
+            "\" - use 0 (low) or 1 (high)");
+        have_valid_configuration = false;
+    }
+
+    // The sensor allows sequential trigger only as target, fast only as controller.
+    const auto triggerMode = TriggerModeSetting();
+    if (!triggerMode) {
+        log("  ERROR: IMX900_TRIGGER_MODE=\"", std::getenv("IMX900_TRIGGER_MODE"),
+            "\" - use 0 (normal), 1 (sequential) or 2 (fast)");
+        have_valid_configuration = false;
+    } else if ((*triggerMode == TriggerMode::Sequential) && !m_isStereo) {
+        log("  ERROR: sequential trigger needs the sync target (J6 in IMX900_DUAL_SYNC)");
+        have_valid_configuration = false;
+    } else if ((*triggerMode == TriggerMode::Fast) && m_isStereo) {
+        log("  ERROR: fast trigger needs the controller, not the sync target");
+        have_valid_configuration = false;
+    } else {
+        m_triggerMode = *triggerMode;
+        log("  trigger mode ", TriggerModeName(m_triggerMode));
+    }
+
+    const auto& table = GetDeviceTable();
+    deviceTable.insert(deviceTable.end(), table.begin(), table.end());
+
+    return have_valid_configuration;
+}
+
+bool IMX900ModuleDriver::ProbeHardware(const CoEModuleContext& context) {
+    // This SIPL runtime never calls the module driver's ProbeHardware - it was
+    // confirmed absent from every streaming run. Sensor bring-up (the GPIO
+    // enable pulse and settle) therefore lives in the init sequence, which Init
+    // submits; see seq_init in fr_imx900_hsl.py.
+    log("ProbeHardware called");
+    LogState("ProbeHardware completed", *context.hwAccess);
+    return true;
+}
+
+bool IMX900ModuleDriver::Init(const CoEModuleContext& context) {
+    log("Init called - bringing sensor up and programming registers");
+    m_isMono = ProbeChromacity(*context.hwAccess);
+    context.hwAccess->SubmitSequence(fr_imx900::hsl::init_settings);
+
+    // Height identifies the mode: 1080 the ROI crop, 776 the 1/2 subsampled
+    // readout, anything else the full frame. std::dec explicitly - another
+    // driver leaves std::hex set on std::cout.
+    // A subsampled or binned mode is variant-specific: the wrong config gives
+    // the wrong SHS floor and a broken readout, with no other symptom.
+    const auto needed = m_sensorDriver.ModeVariant();
+    if ((needed == IMX900SensorDriver::Variant::Mono) && !m_isMono) {
+        log("  ERROR: this config is for a MONO sensor but a COLOUR one is "
+            "fitted - use the non-_MONO config for ", std::dec, m_width, "x", m_height);
+    } else if ((needed == IMX900SensorDriver::Variant::Colour) && m_isMono) {
+        log("  ERROR: this config is for a COLOUR sensor but a MONO one is "
+            "fitted - use the _MONO config for ", std::dec, m_width, "x", m_height);
+    }
+
+    log("  programming ", std::dec, m_width, "x", m_height,
+        (m_isMono ? " mono" : " colour"));
+    // Each sequence is its own HSLStaticSequence<N> type, so no ternary here.
+    if (m_height == 720U) {
+        // 2x2 average is a mono-only readout; a colour part has no equivalent.
+        if (m_isMono) {
+            context.hwAccess->SubmitSequence(fr_imx900::hsl::mode_1024x720_raw12_mono);
+        } else {
+            // The 1/2 subsampling fallback will be available in a future release.
+            // log("  WARNING: 2x2 average is mono-only; falling back to 1/2 subsampling");
+            // context.hwAccess->SubmitSequence(fr_imx900::hsl::mode_1032x776_raw12);
+            log("  ERROR: 2x2 average is mono-only and there is no colour fallback");
+            return false;
+        }
+    }
+#if 0
+    // 1920x1080 and 1032x776 will be available in a future release.
+    else if (m_height == 1080U) {
+        if (m_isMono) {
+            context.hwAccess->SubmitSequence(fr_imx900::hsl::mode_1920x1080_raw12_mono);
+        } else {
+            context.hwAccess->SubmitSequence(fr_imx900::hsl::mode_1920x1080_raw12);
+        }
+    } else if (m_height == 776U) {
+        if (m_isMono) {
+            context.hwAccess->SubmitSequence(fr_imx900::hsl::mode_1032x776_raw12_mono);
+        } else {
+            context.hwAccess->SubmitSequence(fr_imx900::hsl::mode_1032x776_raw12);
+        }
+    }
+#endif
+    else {
+        if (m_isMono) {
+            context.hwAccess->SubmitSequence(fr_imx900::hsl::mode_2048x1552_raw12_mono);
+        } else {
+            context.hwAccess->SubmitSequence(fr_imx900::hsl::mode_2048x1552_raw12);
+        }
+    }
+
+    // The mode table programs the top rate; this lowers it to the configured fps.
+    m_sensorDriver.ApplyFrameLength(*context.hwAccess);
+
+    // The sensor marked with sensorGroup follows the other's XVS/XHS
+    // (IMX900_DUAL_SYNC: J6). Unmarked configs never wait for one.
+    // TODO: change when config is updated
+    m_isTarget = m_isStereo;
+
+    if (m_isTarget) {
+        context.hwAccess->SubmitSequence(fr_imx900::hsl::target_mode);
+    }
+    log("  sync role ", (m_isTarget ? "TARGET: XVS/XHS inputs" : "CONTROLLER"));
+
+    // The mode tables don't set FDG_SEL, so write it here, low included,
+    // instead of relying on the sensor's power-up value.
+    if (m_sensorDriver.GetConversionGain() == ConversionGain::High) {
+        context.hwAccess->SubmitSequence(fr_imx900::hsl::conversion_gain_high);
+    } else {
+        context.hwAccess->SubmitSequence(fr_imx900::hsl::conversion_gain_low);
+    }
+
+    // Exposure then starts on XTRIG instead of the internal timing. Normal
+    // needs nothing: the mode tables program it.
+    if (m_triggerMode == TriggerMode::Fast) {
+        if (m_height == 720U) {
+            context.hwAccess->SubmitSequence(fr_imx900::hsl::trigger_fast_1024x720);
+        } else {
+            context.hwAccess->SubmitSequence(fr_imx900::hsl::trigger_fast_2048x1552);
+        }
+    } else if (m_triggerMode == TriggerMode::Sequential) {
+        if (m_height == 720U) {
+            context.hwAccess->SubmitSequence(fr_imx900::hsl::trigger_sequential_1024x720);
+        } else {
+            context.hwAccess->SubmitSequence(fr_imx900::hsl::trigger_sequential_2048x1552);
+        }
+    }
+
+    LogState("Init complete", *context.hwAccess);
+    return true;
+}
+
+bool IMX900ModuleDriver::Deinit(const CoEModuleContext& context) {
+    LogState("Deinit called", *context.hwAccess);
+
+    // Deinit can be reached without a preceding StopStreaming (an aborted
+    // pipeline, or a client that just tears down). Without this the sensor is
+    // left running - XMSTA active, never returned to standby - still pushing
+    // frames at the bridge. Mirrors EagleModuleDriver::Deinit.
+    if (m_is_streaming) {
+        log("Stopping streaming during deinit");
+        if (context.hwAccess != nullptr) {
+            context.hwAccess->SubmitSequence(fr_imx900::hsl::stop);
+        }
+        m_is_streaming = false;
+    }
+
+    return true;
+}
+
+bool IMX900ModuleDriver::Reset(const CoEModuleContext& context) {
+    LogState("Reset called", *context.hwAccess);
+    return true;
+}
+
+} // namespace uddf::samples
