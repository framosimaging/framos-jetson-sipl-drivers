+namespace {
+
+// Chromacity information register; bit 7 is 0 for colour, 1 for mono.
+constexpr uint16_t IMX900_CHROMACITY_REG { 0x3817U };
+
+// SubmitSequence returns before the queued bring-up (~80 ms of delays) has
+// run, and until it has the register reads 0x00 - indistinguishable from a
+// genuine colour sensor, so a premature read misdetects a mono part silently.
+// IHardwareAccess exposes no completion or flush call, so the only lever is
+// waiting. Measured on this board the value is readable ~2 ms after wake;
+// 500 ms is that with two orders of magnitude of headroom, paid once per Init.
+constexpr uint32_t CHROMACITY_SETTLE_MS { 500U };
+
+template<typename... Args>
+void log(Args... args) {
+    std::cout << "    [IMX900 module] ";
+    (std::cout << ... << args);
+    std::cout << std::endl;
+}
+
+using ConversionGain = IMX900SensorDriver::ConversionGain;
+
+// Process-wide for now: IMX900_CONVERSION_GAIN=0 (low) | 1 (high), the FDG_SEL
+// value; unset = 0. Move to the platform config once a per-camera field
+// reaches the driver.
+std::optional<ConversionGain> ConversionGainSetting() {
+    const char* const value = std::getenv("IMX900_CONVERSION_GAIN");
+    if ((value == nullptr) || (std::string_view(value) == "0")) {
+        return ConversionGain::Low;
+    }
+    if (std::string_view(value) == "1") {
+        return ConversionGain::High;
+    }
+    return std::nullopt;
+}
+
+using TriggerMode = IMX900ModuleDriver::TriggerMode;
+
+// Process-wide for now: IMX900_TRIGGER_MODE=0 (normal) | 1 (sequential) |
+// 2 (fast), the FRAMOS shutter-mode values; unset = 0.
+std::optional<TriggerMode> TriggerModeSetting() {
+    const char* const value = std::getenv("IMX900_TRIGGER_MODE");
+    if ((value == nullptr) || (std::string_view(value) == "0")) {
+        return TriggerMode::Normal;
+    }
+    if (std::string_view(value) == "1") {
+        return TriggerMode::Sequential;
+    }
+    if (std::string_view(value) == "2") {
+        return TriggerMode::Fast;
+    }
+    return std::nullopt;
+}
+
+const char* TriggerModeName(TriggerMode mode) {
+    switch (mode) {
+    case TriggerMode::Sequential: return "SEQUENTIAL";
+    case TriggerMode::Fast:       return "FAST";
+    default:                      return "NORMAL";
+    }
+}
