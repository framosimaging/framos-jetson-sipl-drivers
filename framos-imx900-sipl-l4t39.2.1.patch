+IMX900ModuleDriver::GetSensorControl(const CameraModuleContext& context,
+                                     size_t index) {
+    log("GetSensorControl called for index: ", index, ".");
+    if (index == 0) {
+        log("Returning sensor control pointer.");
+        return static_cast<ICameraSensorControl*>(&m_sensorDriver);
+    }
+    log("No such sensor control index (", index, ") found.");
+    return nullptr;
+}
