diff --git a/sipl/uddf/drivers/sensors/IMX900/fr_imx900_hsl.py b/sipl/uddf/drivers/sensors/IMX900/fr_imx900_hsl.py
new file mode 100755
index 0000000..1f03151
--- /dev/null
+++ b/sipl/uddf/drivers/sensors/IMX900/fr_imx900_hsl.py
@@ -0,0 +1,258 @@
+#! /usr/bin/env python3
+# SPDX-FileCopyrightText: Copyright (c) 2026 FRAMOS GmbH
+# SPDX-License-Identifier: Apache-2.0
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+# http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+#
+# IMX900 HSL sequences for the CoE / Holoscan Sensor Bridge path.
+
+from pyhsl import *
+from fr_imx900_data import *
+
+from enum import Enum
+# set up logging
+Configuration.set_default_logger('DEBUG')
+
+if __name__ == '__main__':
+    Configuration.set_values({}, None, ph_logger())
+
+
+# Camera I2C address - exported as C++ constant.
+ph_define_constant('CAM_I2C_ADDRESS', 0x1a)
+ph_define_constant('I2C_EXPANDER_I2C_ADDRESS', 0x70)
+ph_define_constant('GPIO_EXPANDER_I2C_ADDRESS', 0x20)
+
+# Frame timing of the programmed mode, so IMX900SensorDriver.cpp reads the
+# same numbers the register table is built from.
+ph_define_constant('INCK_HZ', SENSOR_INCK_HZ)
+ph_define_constant('HMAX',    HMAX_891_12B)
+ph_define_constant('HMAX_MONO_SUB', HMAX_891_12B_MONO_SUB)
+ph_define_constant('VMAX_2048X1552', VMAX_ROI2048_891)
+ph_define_constant('VMAX_1920X1080', VMAX_ROI1080_891)
+ph_define_constant('VMAX_1032X776',  VMAX_SUB2_891)
+ph_define_constant('VMAX_1032X776_MONO', VMAX_SUB2_MONO_891)
+ph_define_constant('VMAX_1024X720_MONO', VMAX_BIN2X2_MONO_891)
+ph_define_constant('MIN_SHS', MIN_SHS_891)
+ph_define_constant('MIN_SHS_MONO_SUB', MIN_SHS_891_MONO_SUB)
+ph_define_constant('GAIN_REG_MIN_HCG', HCG_GAIN_REG_MIN)
+
+def write_buffer(dev, offset, data):
+    chunk_size = 120
+    with dev:
+        for i in range(0, len(data), chunk_size):
+            chunk = data[i:i+chunk_size]
+            write(offset+i, chunk)
+
+# Setup the devices
+ph_logger().info('FRAMOS: Setting up IMX900 devices')
+fr_imx900 = I2CDevice(CAM_I2C_ADDRESS, 16, 8, 'FrImx900')
+i2c_expander = I2CDevice(I2C_EXPANDER_I2C_ADDRESS, 8, 8, 'i2c_expander')
+gpio_expander = I2CDevice(GPIO_EXPANDER_I2C_ADDRESS, 8, 8, 'gpio_expander')
+
+gain_layout = MemoryLayout('gain_register')
+gain_layout.addItem('gain', 2)
+gain_block = MemoryBlock(gain_layout, 'gain_block')
+
+exposure_layout = MemoryLayout('exposure_register')
+exposure_layout.addItem('exposure', 3)
+exposure_block = MemoryBlock(exposure_layout, 'exposure_block')
+
+vmax_layout = MemoryLayout('vmax_register')
+vmax_layout.addItem('vmax', 3)
+vmax_block = MemoryBlock(vmax_layout, 'vmax_block')
+
+def seq_bringup():
+    """Power the sensor with the GPIO enable pulse."""
+    ph_logger().info('FRAMOS: Entering IMX900 bringup sequence')
+    with Sequence('bringup') as seq:
+        annotate('bringup')
+
+
+        # The 0x20 expander drives the camera control lines
+        with gpio_expander:
+            CONFIGURATION_REGISTER  = 0x03
+            OUTPUT_PORT_REGISTER    = 0x01
+
+            write(CONFIGURATION_REGISTER, 0x00) # all expander pins are outputs
+            write(OUTPUT_PORT_REGISTER, 0x00)   # drive them all low
+            delay(1000)
+
+            write(OUTPUT_PORT_REGISTER, 0x04)   # release the enable high
+            # Sensor recovery after the pulse, plus IMX900 boot settle before
+            # the first sensor write. See note above.
+            delay(60000)
+
+
+def seq_init_settings():
+    """Mode-independent init settings, written once the chromacity is known."""
+    ph_logger().info('FRAMOS: Entering IMX900 init_settings sequence')
+    with Sequence('init_settings') as seq:
+        annotate('init_settings')
+        with fr_imx900:
+            write(STANDBY, 0x01)
+            seq.delay(20)
+            for addr, val in imx900_init_settings:
+                write(addr, val)
+            seq.delay(30)
+
+
+def seq_standby(name, value):
+    """Enter or leave standby. Used around the chromacity read"""
+    ph_logger().info('FRAMOS: Entering IMX900 %s sequence' % name)
+    with Sequence(name) as seq:
+        annotate(name)
+        with fr_imx900:
+            write(STANDBY, value)
+            seq.delay(20)
+
+
+def seq_mode(name, mode_table):
+    """Program one mode table. Written in standby, as FRAMOS does."""
+    ph_logger().info('FRAMOS: Entering IMX900 %s sequence' % name)
+    with Sequence(name) as seq:
+        annotate(name)
+        with fr_imx900:
+            write(STANDBY, 0x01)
+            seq.delay(20)
+            for addr, val in mode_table:
+                write(addr, val)
+            seq.delay(30)
+
+
+def seq_start():
+    with Sequence('start'):
+        annotate('start')
+        with fr_imx900:
+            write(STANDBY, 0x00)  # Exit standby
+            delay(30)
+            write(XMSTA, 0x00)    # Start internal sync (controller)
+            delay(300)
+
+def seq_target_mode():
+    """Retarget XVS/XHS as inputs; applied after the mode table (controller)."""
+    with Sequence('target_mode'):
+        annotate('target_mode')
+        # Expander P3 (the XMASTER pin) flips the adapter's XVS/XHS buffers to input.
+        # P2 (power enable) stays high: 0x00 would cut the module.
+        with gpio_expander:
+            write(0x01, 0x0C)
+            delay(1000)
+        with fr_imx900:
+            write(SYNCSEL, 0xF0)  # XVS/XHS Hi-Z (inputs)
+            delay(30)
+
+def seq_start_target():
+    """Leave standby but keep XMSTA stopped: frames follow the controller's XVS."""
+    with Sequence('start_target'):
+        annotate('start_target')
+        with fr_imx900:
+            write(STANDBY, 0x00)  # Exit standby
+            delay(30)
+            write(XMSTA, 0x01)    # Internal sync stays stopped
+            delay(300)
+
+def seq_stop():
+    with Sequence('stop'):
+        annotate('stop')
+        with fr_imx900:
+            write(XMSTA, 0x01)    # Stop internal sync
+            delay(30)
+            write(STANDBY, 0x01)  # Enter standby
+            delay(30)
+
+def seq_reghold(name, value):
+    """Open or close the REGHOLD bracket."""
+    with Sequence(name) as seq:
+        annotate(name)
+        with fr_imx900:
+            write(REGHOLD, value)
+
+
+def seq_conversion_gain(name, fdg_sel):
+    """FDG_SEL after the mode table. HCG also lifts the table's 1.6 dB start
+    gain to its 3 dB floor, which SetGain enforces from then on."""
+    with Sequence(name):
+        annotate(name)
+        with fr_imx900:
+            write(FDG_SEL, fdg_sel)
+            if fdg_sel:
+                write(GAIN_LOW, HCG_GAIN_REG_MIN)
+                write(GAIN_HIGH, 0x00)
+
+def seq_trigger(name, readout_bits, trigger):
+    """TRIGMODE and VINT_EN for a trigger mode, after the mode table."""
+    with Sequence(name):
+        annotate(name)
+        with fr_imx900:
+            write(TRIGMODE, TRIGMODE_VALUES[trigger])
+            write(VINT_EN, readout_bits | VINT_EN_MODE_BITS[trigger])
+
+def seq_set_gain():
+    with Sequence('set_gain'):
+        annotate('set_gain')
+        with fr_imx900:
+            writeFromMemory(GAIN_LOW, gain_block.gain)
+
+
+def seq_set_exposure():
+    with Sequence('set_exposure'):
+        annotate('set_exposure')
+        with fr_imx900:
+            writeFromMemory(SHS_LOW, exposure_block.exposure)
+
+def seq_set_vmax():
+    """Frame length from the configured fps; after the mode table, which
+    programs the mode's floor."""
+    with Sequence('set_vmax'):
+        annotate('set_vmax')
+        with fr_imx900:
+            writeFromMemory(VMAX_LOW, vmax_block.vmax)
+
+# start the main dump
+def main():
+    ph_logger().info('FRAMOS: Entering IMX900 main sequence')
+
+    seq_bringup()
+    seq_init_settings()
+    seq_standby('wake', 0x00)
+    seq_standby('standby', 0x01)
+    seq_mode('mode_2048x1552_raw12', imx900_mode_2064x1552_12BPP)
+    # 1920x1080 and 1032x776 will be available in a future release.
+    # seq_mode('mode_1920x1080_raw12', imx900_mode_1920x1080_12BPP)
+    # seq_mode('mode_1032x776_raw12', imx900_mode_1032x776_12BPP)
+
+    seq_mode('mode_2048x1552_raw12_mono', imx900_mode_2048x1552_12BPP_MONO)
+    # seq_mode('mode_1920x1080_raw12_mono', imx900_mode_1920x1080_12BPP_MONO)
+    # seq_mode('mode_1032x776_raw12_mono', imx900_mode_1032x776_12BPP_MONO)
+    seq_mode('mode_1024x720_raw12_mono', imx900_mode_1024x720_12BPP_MONO)
+
+    seq_start()
+    seq_start_target()
+    seq_target_mode()
+    seq_stop()
+    seq_reghold('reghold_on', 0x01)
+    seq_reghold('reghold_off', 0x00)
+    # Normal needs no sequence: the mode tables already program it.
+    for trigger in ('sequential', 'fast'):
+        seq_trigger('trigger_%s_2048x1552' % trigger, VINT_EN_READOUT_ALL_PIXEL, trigger)
+        seq_trigger('trigger_%s_1024x720' % trigger, VINT_EN_READOUT_BINNING, trigger)
+    seq_conversion_gain('conversion_gain_low', 0x00)
+    seq_conversion_gain('conversion_gain_high', 0x01)
+    seq_set_gain()
+    seq_set_exposure()
+    seq_set_vmax()
+
+    ph_logger().info('FRAMOS: Successfully completed IMX900 main sequence')
+
+if __name__ == '__main__':
+    main()
