+# ---------------------------------------------------------------------------
+# Mode construction
+#
+# A mode is (data rate) x (bit depth) x (readout variant) x (geometry). Each of
+# the first three is a dict of just the registers that differ, all taken from
+# the FRAMOS fr_imx900_mode_tbls.h tables, so a new combination is one call to
+# _mode() rather than a copied register list.
+# ---------------------------------------------------------------------------
+
+# D-PHY timing + PLL, from the imx900_<rate>_mbps tables.
+PHY_891 = {
+    "scal_init_en": 0x00,
+    "ths_prepare":  0x003F, "tclk_post":    0x007F,
+    "ths_trail":    0x003F, "ths_zero":     0x007F,
+    "tclk_prepare": 0x003F, "tclk_trail":   0x003F,
+    "tlpx":         0x003F, "tclk_zero":    0x010F,
+    "ths_exit":     0x006F,
+    "incksel":      (0x0C, 0x0D, 0xC8),
+}
+
+# Readout timing, which is rate-dependent and must move with the PHY block.
+# Leaving these stale while changing the rate makes the sensor emit constant
+# black-level pixels at a perfectly clean frame rate.
+READOUT_891 = {
+    "gmrwt": 0x11, "gmtwt": 0x27, "gaindly": 0x02, "gsdly": 0x01,
+    "reg_36a8": 0x11, "reg_36a9": 0x1D, "gmrwt2": 0x0C, "gmrwt3": 0x17,
+}
+
+# Readout timing for the mono 1/2-subsampling and 2x2-average readouts;
+# FRAMOS picks it by chromacity (subsampling2_binning_MONO_891MBPS_1x12_4LANE).
+READOUT_891_MONO_SUB = {
+    "gmrwt": 0x20, "gmtwt": 0x48, "gaindly": 0x02, "gsdly": 0x02,
+    "reg_36a8": 0x20, "reg_36a9": 0x36, "gmrwt2": 0x16, "gmrwt3": 0x2C,
+}
+
+DEPTH_12BIT = {
+    "black_level": 240,
+    "adbit_monosel": 0x11, "odbit": 0x01,
+    "reg_5572": 0x1F, "reg_5613": 0x8F,
+}
+
+DEPTH_12BIT_MONO = {
+    "black_level": 240,
+    "adbit_monosel": 0x15, "odbit": 0x01,
+    "reg_5572": 0x1F, "reg_5613": 0x8F,
+}
+
+ROI = {
+    # Trailing constant of the FRAMOS min-frame-length formula.
+    "vmax_blanking": 56,
+    "hvmode":        0x00,
+    "roi_enable":    0x03,
+    "llblank":       0x000F,
+    "vint_en":       VINT_EN_READOUT_ALL_PIXEL | VINT_EN_MODE_BITS["normal"],
+    "reg_3521":      0x1A,
+    "reg_3546":      0x06,
+}
+
+BINNING2X2_MONO = {
+    # FRAMOS mode_1024x720[] + mode_subsampling2_binning_mono[]. 2x2 average
+    # destroys the Bayer phase, so FRAMOS exposes it as mono only.
+    "vmax_blanking": 38,
+    "hvmode":        0x10,
+    "roi_enable":    0x03,
+    "llblank":       0x000D,
+    "vint_en":       VINT_EN_READOUT_BINNING | VINT_EN_MODE_BITS["normal"],
+    "reg_3521":      0x0E,
+    "reg_3546":      0x03,
+}
+
+SUBSAMPLING2_MONO = {
+    # FRAMOS mode_subsampling2_binning_mono[]; shared with the 2x2 average.
+    "vmax_blanking": 38,
+    "hvmode":        0x08,
+    "roi_enable":    0x00,
+    "llblank":       0x000D,
+    "vint_en":       VINT_EN_READOUT_SUBSAMPLING2_MONO | VINT_EN_MODE_BITS["normal"],
+    "reg_3521":      0x0E,
+    "reg_3546":      0x03,
+}
+
+SUBSAMPLING2_COLOR = {
+    #  1032x776 mode
+    "vmax_blanking": 34,
+    "hvmode":        0x08,
+    "roi_enable":    0x00,
+    "llblank":       0x000B,
+    "vint_en":       VINT_EN_READOUT_SUBSAMPLING2_COLOR | VINT_EN_MODE_BITS["normal"],
+    "reg_3521":      0x0E,
+    "reg_3546":      0x03,
+}
+
+
+def _low_byte(value):
+    """Low 8 bits of a value, for the *_LOW half of a register pair."""
+    return value & 0xFF
+
+
+def _mid_byte(value):
+    """Bits 15:8, for the *_HIGH half. Mirrors IMX900_TO_MID_BYTE in the
+    FRAMOS fr_imx900_mode_tbls.h."""
+    return (value >> 8) & 0xFF
+
+
+def _mode(hmax, vmax, width, height, roi_x, roi_y,
+          phy=None, depth=None, variant=ROI, readout=None,
+          roi_w=None, roi_h=None, finfo_hwidth=None, vopb_hwid=None):
+    """Build a mode register list.
+
+    hmax/vmax set the frame timing; width/height/roi_* select the readout
+    window. phy, depth, variant and readout each contribute only the registers
+    that distinguish them. roi_w/roi_h default to the output size and exist so
+    a crop can be expressed in a different coordinate space if needed.
+    """
+    if phy is None:
+        phy = PHY_891
+    if depth is None:
+        depth = DEPTH_12BIT
+    if readout is None:
+        readout = READOUT_891
+    if roi_w is None:
+        roi_w = width
+    if roi_h is None:
+        roi_h = height
+    # FINFO_HWIDTH sets the frame-info (embedded) line width and VOPB_VBLK_HWID
+    # the optical-black width; both default to the image width.
+    if finfo_hwidth is None:
+        finfo_hwidth = width
+    if vopb_hwid is None:
+        vopb_hwid = width
+
+    d1, d2, d3 = phy["incksel"]
+    return [
+    # ---- Frame timing and lane count ----
+    (HMAX_LOW,      _low_byte(hmax)),
+    (HMAX_HIGH,     _mid_byte(hmax)),
+
+    (LANESEL,       0x02),  # 4 lanes
+
+    (VMAX_LOW,      _low_byte(vmax)),
+    (VMAX_MID,      _mid_byte(vmax)),
+    (VMAX_HIGH,     0x00),
+
+    (SHS_LOW,      0x6a),
+    (SHS_MID,      0x02),
+    (SHS_HIGH,     0x00),
+    (GAIN_LOW,     0x10),
+    (GAIN_HIGH,    0x00),  # gain reg = 0x0010 = 16 -> 1.6 dB (1.20x)
+
+    # ---- ADC / output bit depth (colour sensor) ----
+    (0x3200, depth["adbit_monosel"]),  # ADBIT_MONOSEL
+    (0x3430, depth["odbit"]),          # ODBIT
+    (0x5572, depth["reg_5572"]),       # internal trim
+    (0x5613, depth["reg_5613"]),       # internal trim
+
+    # ---- Readout-variant settings (all-pixel vs 1/2 subsampling) ----
+    (LLBLANK_LOW,   _low_byte(variant["llblank"])),
+    (LLBLANK_HIGH,  _mid_byte(variant["llblank"])),
+    (0x3521,        variant["reg_3521"]),
+    (0x3546,        variant["reg_3546"]),
+
+    (HVMODE,                variant["hvmode"]),
+    (VOPB_VBLK_HWID_LOW,    _low_byte(vopb_hwid)),
+    (VOPB_VBLK_HWID_HIGH,   _mid_byte(vopb_hwid)),
+    (FINFO_HWIDTH_LOW,      _low_byte(finfo_hwidth)),
+    (FINFO_HWIDTH_HIGH,     _mid_byte(finfo_hwidth)),
+    (FID0_ROI,              variant["roi_enable"]),
+
+    (FID0_ROIPH1_LOW,       _low_byte(roi_x)),
+    (FID0_ROIPH1_HIGH,      _mid_byte(roi_x)),
+    (FID0_ROIPV1_LOW,       _low_byte(roi_y)),
+    (FID0_ROIPV1_HIGH,      _mid_byte(roi_y)),
+
+    (FID0_ROIWH1_LOW,       _low_byte(roi_w)),
+    (FID0_ROIWH1_HIGH,      _mid_byte(roi_w)),
+
+    (FID0_ROIWV1_LOW,       _low_byte(roi_h)),
+    (FID0_ROIWV1_HIGH,      _mid_byte(roi_h)),
+
+    # ---- MIPI D-PHY timing + PLL ----
+    (SCAL_INIT_EN,  phy["scal_init_en"]),
+    (0x3CA8, _low_byte(phy["ths_prepare"])),   # THS_PREPARE_LOW
+    (0x3CA9, _mid_byte(phy["ths_prepare"])),
+    (0x3CAA, _low_byte(phy["tclk_post"])),     # TCLK_POST_LOW
+    (0x3CAB, _mid_byte(phy["tclk_post"])),
+    (0x3CAC, _low_byte(phy["ths_trail"])),     # THS_TRAIL_LOW
+    (0x3CAD, _mid_byte(phy["ths_trail"])),
+    (0x3CAE, _low_byte(phy["ths_zero"])),      # THS_ZERO_LOW
+    (0x3CAF, _mid_byte(phy["ths_zero"])),
+    (0x3CB0, _low_byte(phy["tclk_prepare"])),  # TCLK_PREPARE_LOW
+    (0x3CB1, _mid_byte(phy["tclk_prepare"])),
+    (0x3CB2, _low_byte(phy["tclk_trail"])),    # TCLK_TRAIL_LOW
+    (0x3CB3, _mid_byte(phy["tclk_trail"])),
+    (0x3CB4, _low_byte(phy["tlpx"])),          # TLPX_LOW
+    (0x3CB5, _mid_byte(phy["tlpx"])),
+    (0x3CB6, _low_byte(phy["tclk_zero"])),     # TCLK_ZERO_LOW
+    (0x3CB7, _mid_byte(phy["tclk_zero"])),
+    (0x3CBA, _low_byte(phy["ths_exit"])),      # THS_EXIT_LOW
+    (0x3CBB, _mid_byte(phy["ths_exit"])),
+    (0x4111, d1),  # INCKSEL_D1
+    (0x4112, d2),  # INCKSEL_D2
+    (0x4116, d3),  # INCKSEL_D3
+
+    # ---- Rate-dependent readout timing ----
+    (GMRWT,         readout["gmrwt"]),
+    (GMTWT,         readout["gmtwt"]),
+    (GAINDLY,       readout["gaindly"]),
+    (GSDLY,         readout["gsdly"]),
+    (IMX900_36A8,   readout["reg_36a8"]),
+    (IMX900_36A9,   readout["reg_36a9"]),
+    (GMRWT2,        readout["gmrwt2"]),
+    (GMRWT3,        readout["gmrwt3"]),
+
+    # ---- Trigger / sync: controller mode, normal exposure ----
+    (TRIGMODE, 0x00),  # no external trigger (free-run); seq_trigger overrides
+    (SYNCSEL, 0xC0),  # controller mode (XVS/XHS output); seq_target_mode overrides
+    (VINT_EN, variant["vint_en"]),  # normal exposure, per readout variant
+
+    # ---- Black level, per bit depth (FRAMOS IMX900_DEFAULT_BLACK_LEVEL_*BPP) ----
+    (0x35B4, _low_byte(depth["black_level"])),
+    (0x35B5, _mid_byte(depth["black_level"])),
+
+     # No test pattern
+    (0x3550, 0x06),
+    ]
+
+
+# ---------------------------------------------------------------------------
+# Mode instances
+#
+# HMAX from imx900_adjust_hmax_register() in FRAMOS fr_imx900.c; VMAX sets
+# the frame rate.
+# ---------------------------------------------------------------------------
+
+# --- 891 Mbps, 12-bit ---
+# Exported to C++ via ph_define_constant in fr_imx900_hsl.py, so the driver
+# and the register table cannot drift apart.
+SENSOR_INCK_HZ    = 74250000   # IMX900_INCK in FRAMOS fr_imx900.c
+HMAX_891_12B      = 610        # 0x0262
+# Mono subsampling and 2x2 average use a shorter line (fr_imx900.c 0x147).
+HMAX_891_12B_MONO_SUB = 327    # 0x0147
+
+
+def min_vmax(height, variant, readout):
+    return (height + readout["gmrwt"] + 2 * readout["gmrwt2"]
+            + readout["gmtwt"] + readout["gsdly"] + variant["vmax_blanking"])
+
+
+# VMAX at the readout floor, so each mode runs at the highest rate it allows.
+VMAX_ROI2048_891  = min_vmax(1552, ROI, READOUT_891)   # 1689 -> 72.1 fps
+VMAX_ROI1080_891  = min_vmax(1080, ROI, READOUT_891)   # 1217 -> 100.0 fps
+VMAX_SUB2_891     = min_vmax(776, SUBSAMPLING2_COLOR, READOUT_891)  # 891 -> 136.6 fps
+
+VMAX_SUB2_MONO_891 = 1419   # 0x58B -> 160.0 fps
+VMAX_BIN2X2_MONO_891 = 1419   # 0x58B -> 160.0 fps
+
+MIN_SHS_891 = READOUT_891["gmtwt"] + READOUT_891["gmrwt2"]
+MIN_SHS_891_MONO_SUB = READOUT_891_MONO_SUB["gmtwt"] + READOUT_891_MONO_SUB["gmrwt2"]
+
+imx900_mode_2064x1552_12BPP = _mode(
+    HMAX_891_12B, VMAX_ROI2048_891, 2048, 1552, 8, 0,
+    PHY_891, DEPTH_12BIT, ROI, READOUT_891)
+
