+    const uint8_t channel = m_muxChannels[sensorID];
+    if (channel == m_muxChannel) {
+        return true;
+    }
+
+    try {
+        // Exactly one bit: two open channels tie both modules onto the bus.
+        i2cIf->i2c_transaction(CAM_I2C_MUX_ADDRESS, { channel }, 0U);
+    } catch (const std::exception& e) {
+        log("Error selecting camera mux channel 0x", std::hex,
+            static_cast<uint32_t>(channel), std::dec, " for sensor ", sensorID,
+            ": ", e.what());
+        m_muxChannel = 0U;
+        return false;
+    }
+
+    // With two sensors the mux flips on nearly every transaction; debug only.
+    log_ext("Camera I2C mux -> channel 0x", std::hex, static_cast<uint32_t>(channel),
+            std::dec, " (sensor ", sensorID, ")");
+    m_muxChannel = channel;
+    return true;
+}
