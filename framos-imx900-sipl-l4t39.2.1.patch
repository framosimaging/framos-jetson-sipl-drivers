+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "uddf/ddi/discovery.hpp"
+
+#include "IMX900ModuleDriver.hpp"
+#include "HsbTransportDriver.hpp"
+#include <memory>
+#include <vector>
+#include <string>
+
+namespace uddf::samples {
+
+const ddi::DriverInfo g_imx900DriverInfo = {
+    .name         = "IMX900",
+    .description  = "A driver for CoE (Camera over Ethernet) functionality via UDDF for the IMX900 sensor",
+    .vendor       = "Framos GmbH",
+    .revision     = "1.0.0"
+};
+
+const ddi::DriverInfo g_hsbTransportDriverInfo = {
+    .name         = "HsbTransport900",
+    .description  = "HSB (Holoscan Sensor Bridge) transport driver for the IMX900 sensor",
+    .vendor       = "Framos GmbH",
+    .revision     = "1.0.0"
+};
+
+class IMX900LibraryEnumerator final : public ddi::IDriverEnumerator {
+public:
+    std::string_view GetName() const override {
+        return "IMX900CameraModuleDriverProvider";
+    }
+
+    size_t GetDriverCount() const override {
+        return 2;
+    }
+
+    const ddi::DriverInfo* GetDriverInfo(size_t index) const override {
+        switch (index) {
+        case 0: return &g_imx900DriverInfo;
+        case 1: return &g_hsbTransportDriverInfo;
+        default: return nullptr;
+        }
+    }
+
+    std::unique_ptr<ddi::IDriver> CreateDriver(size_t index) override {
+        switch (index) {
+        case 0: return std::make_unique<IMX900ModuleDriver>();
+        // Deliver each device's register-offset width to the transport. This
+        // SIPL runtime never calls SetDeviceOffsetWidth() itself, so the widths
+        // the module driver declares for the framework are pushed in here from
+        // the same table - they must be set before any I2C traffic, and
+        // CreateDriver() runs before ConfigureDriver()/ProbeHardware()/Init().
+        case 1: {
+            auto transport = std::make_unique<HsbTransportDriver>();
+            for (const auto& device : IMX900ModuleDriver::GetDeviceTable()) {
+                transport->SetDeviceOffsetWidth(device.i2cAddress, device.offsetWidth);
+            }
+            // P-Con: both camera ports share one I2C bus behind the 0x70 mux;
+            // sensor 0 is J5 (channel 0x01), sensor 1 is J6 (0x04).
+            transport->SetCameraMuxChannels({ 0x01U, 0x04U });
+            return transport;
+        }
+        default: return nullptr;
+        }
+    }
+};
+
+} // namespace uddf::samples
+
+extern "C" {
+    uddf::ddi::DriverEnumeratorPtr uddf_discover_drivers() {
+        return std::make_unique<uddf::samples::IMX900LibraryEnumerator>();
+    }
+}
