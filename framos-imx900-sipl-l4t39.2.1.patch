+
+#include "IMX900SensorDriver.hpp"
+
+#include <iostream>
+#include <string>
+#include <cmath>
+#include <algorithm>
+#include <cstdlib>
+
+#include "uddf/ddi/interfaces/SensorControlTypes.hpp"
+#include "uddf/cdi/IHardwareAccess.hpp"
+#include "uddf/cdi/IDriverServices.hpp"
+
+// Generated file containing HSL bytecode blobs
+#include "fr_imx900_hsl.hpp"
+
+namespace uddf::samples {
+
+using namespace uddf::ddi::interfaces;
+using namespace fr_imx900::hsl;
+
+namespace {
+
+template<typename... Args>
+void log(Args... args) {
+    std::cout << "    [IMX900 sensor] ";
+    (std::cout << ... << args);
+    std::cout << std::endl;
+}
+
+bool debugLogEnabled() {
+    static const bool enabled = [] {
+        const char* const env = std::getenv("IMX900_DEBUG");
+        return (env != nullptr) && (env[0] != '\0') && (env[0] != '0');
+    }();
+    return enabled;
+}
+
+template<typename... Args>
+void logDebug(Args... args) {
+    if (!debugLogEnabled()) {
+        return;
+    }
+    std::cout << "    [IMX900 sensor][DEBUG] ";
+    (std::cout << ... << args);
+    std::cout << std::endl;
+}
+
+// The HMAX_*, VMAX_* values, MIN_SHS and INCK_HZ come from fr_imx900_data.py.
+static constexpr float CLK_HZ { static_cast<float>(INCK_HZ) };
+
+// Frame timing per mode. Mono 1/2 subsampling shares a resolution with the
+// colour one but runs a shorter line, so the configured frame rate separates
+// them - the chromacity is not known this early.
+struct ModeTiming {
+    uint32_t width;
+    uint32_t height;
+    float    fps;
+    uint32_t hmax;
+    uint32_t vmax;
+    // SHS floor = GMTWT + GMRWT2 of the mode's readout set, as FRAMOS reads
+    // back at runtime. Programming below it breaks the readout.
+    uint32_t minShs;
+    sensor_control::PixelOrder cfa;
+    // Full-resolution modes share timing between variants; the subsampled and
+    // binned ones do not, so using the wrong config gives a broken readout.
+    IMX900SensorDriver::Variant variant;
+};
+
+static constexpr ModeTiming MODES[] = {
+    { 2048U, 1552U,  72.1F, HMAX,          VMAX_2048X1552,     MIN_SHS,          sensor_control::PixelOrder::RGGB, IMX900SensorDriver::Variant::Any },
+    // 1920x1080 and 1032x776 will be available in a future release.
+    // { 1920U, 1080U, 100.0F, HMAX,          VMAX_1920X1080,     MIN_SHS,          sensor_control::PixelOrder::RGGB, IMX900SensorDriver::Variant::Any },
+    // { 1032U,  776U, 136.6F, HMAX,          VMAX_1032X776,      MIN_SHS,          sensor_control::PixelOrder::GBRG, IMX900SensorDriver::Variant::Colour },
+    // { 1032U,  776U, 160.0F, HMAX_MONO_SUB, VMAX_1032X776_MONO, MIN_SHS_MONO_SUB, sensor_control::PixelOrder::GBRG, IMX900SensorDriver::Variant::Mono },
+    { 1024U,  720U, 160.1F, HMAX_MONO_SUB, VMAX_1024X720_MONO, MIN_SHS_MONO_SUB, sensor_control::PixelOrder::NONE, IMX900SensorDriver::Variant::Mono },
+};
+
+static constexpr float FPS_MIN { 1.5F };
+
+// No HDR: exposure 0 is the only one.
+static constexpr uint8_t IMX900_NUM_EXPOSURES { 1U };
+
+static constexpr float SENSOR_GAIN_MIN { 1.0F };
+static constexpr float SENSOR_GAIN_MAX { 248.0F };
+static constexpr float GAIN_DB_SCALE { 200.0F };
+static constexpr uint16_t GAIN_REG_MAX { 479U };
+// HCG floor as linear gain: 10^(reg / 200), reg 30 = 3 dB = 1.413x.
+const float SENSOR_GAIN_MIN_HCG {
+    std::pow(10.0F, static_cast<float>(fr_imx900::hsl::GAIN_REG_MIN_HCG) / GAIN_DB_SCALE) };
+
+// VMAX for the requested fps. The table VMAX is the readout floor, i.e. the
+// mode's top rate; a lower fps only stretches the frame.
+uint32_t VmaxForFps(const ModeTiming& mode, float fps) {
+    const float maxFps = CLK_HZ / (static_cast<float>(mode.hmax) * static_cast<float>(mode.vmax));
+    if (!std::isfinite(fps) || (fps <= 0.0F)) {
+        fps = maxFps;
+    } else if (fps < FPS_MIN) {
+        log("WARNING: ", fps, " fps is below minimum ", FPS_MIN, ", clamping");
+        fps = FPS_MIN;
+    } else if (fps > mode.fps) {
+        // mode.fps, not maxFps: the table rate is rounded, e.g. 72.1 for 72.07.
+        log("WARNING: ", fps, " fps is above the mode maximum ", maxFps, ", clamping");
+    }
+    const uint32_t vmax = static_cast<uint32_t>(
+        std::lround(CLK_HZ / (static_cast<float>(mode.hmax) * fps)));
+    return std::max(vmax, mode.vmax);
+}
+
+} // Anonymous namespace
+
+bool IMX900SensorDriver::SetSensorCharMode([[maybe_unused]] uddf::cdi::IHardwareAccess& hwAccess,
+                                           uddf::cdi::IDriverServices& driverServices,
+                                           const uint8_t exposureNumber) {
+    log("SetSensorCharMode called for exposure ",
+        static_cast<uint32_t>(exposureNumber));
+    UDDF_LOG_DEBUG(driverServices, "SetSensorCharMode called with exposureNumber=%u",
+                   static_cast<uint32_t>(exposureNumber));
+
+    if (exposureNumber >= IMX900_NUM_EXPOSURES) {
+        UDDF_LOG_ERROR(driverServices,
+                       "IMX900: exposure number %u exceeds maximum %u",
+                       static_cast<uint32_t>(exposureNumber),
+                       static_cast<uint32_t>(IMX900_NUM_EXPOSURES - 1U));
+        log("SetSensorCharMode: exposure ", static_cast<uint32_t>(exposureNumber),
+            " out of range (single-exposure sensor)");
+        return false;
+    }
+
+    m_charModeEnabled = true;
+
+    log("SetSensorCharMode: characterization mode enabled");
+    return true;
+}
+
+bool IMX900SensorDriver::SetMode(const uint32_t width, const uint32_t height,
+                                 const float fps) {
+    // Resolution alone is ambiguous: mono and colour 1/2 subsampling are both
+    // 1032x776, so the configured frame rate picks between them.
+    const ModeTiming* best { nullptr };
+    float bestDelta { 0.0f };
+    for (const ModeTiming& mode : MODES) {
+        if ((mode.width != width) || (mode.height != height)) {
+            continue;
+        }
+        const float delta = std::fabs(mode.fps - fps);
+        if ((best == nullptr) || (delta < bestDelta)) {
+            best = &mode;
+            bestDelta = delta;
+        }
+    }
+
+    if (best == nullptr) {
+        log("ERROR: no timing entry for ", std::dec, width, "x", height,
+            " - mode not supported");
+        return false;
+    }
+
+    m_hmax = best->hmax;
+    m_vmax = VmaxForFps(*best, fps);
+    m_cfa = best->cfa;
+    m_minShs = best->minShs;
+    m_variant = best->variant;
+    m_lineTimeNs = (static_cast<float>(m_hmax) / CLK_HZ) * 1e9f;
+    m_minExposure = m_lineTimeNs * 1e-9f;
+    m_maxExposure = static_cast<float>(m_vmax - m_minShs) * m_lineTimeNs * 1e-9f;
+    log("SetMode ", std::dec, width, "x", height, " @ ", fps, " fps: HMAX=", m_hmax,
+        " VMAX=", m_vmax, " -> ",
+        CLK_HZ / (static_cast<float>(m_hmax) * static_cast<float>(m_vmax)), " fps");
+    return true;
+}
+
+void IMX900SensorDriver::ApplyFrameLength(uddf::cdi::IHardwareAccess& hwAccess) const {
+    fr_imx900::hsl::vmax_register vmaxReg{};
+    vmaxReg.vmax[0] = static_cast<uint8_t>(m_vmax & 0xFFU);
+    vmaxReg.vmax[1] = static_cast<uint8_t>((m_vmax >> 8U) & 0xFFU);
+    vmaxReg.vmax[2] = static_cast<uint8_t>((m_vmax >> 16U) & 0xFFU);
+    hwAccess.SubmitSequence(fr_imx900::hsl::set_vmax, vmaxReg);
+}
+
+IMX900SensorDriver::IMX900SensorDriver() {
+    // Keep the derived values consistent with the defaults until SetMode runs.
+    m_lineTimeNs = (static_cast<float>(m_hmax) / CLK_HZ) * 1e9f;
+    m_minExposure = m_lineTimeNs * 1e-9f;
+    m_maxExposure = static_cast<float>(m_vmax - m_minShs) * m_lineTimeNs * 1e-9f;
+}
+
+IMX900SensorDriver::~IMX900SensorDriver() {
+}
+
+bool IMX900SensorDriver::GetSensorAttributes(uddf::cdi::IDriverServices& driverServices,
+                                              SensorAttributes& attributes) const {
+    UDDF_LOG_DEBUG(driverServices, "GetSensorAttributes called - IMX900 Sensor Driver");
+    log("GetSensorAttributes called - IMX900 Sensor Driver");
+    attributes = SensorAttributes{};
+
+    attributes.sensorName = std::string("IMX900");
+    attributes.sensorCFA = m_cfa;
+    attributes.numActiveExposures = 1;
+    attributes.sensorFuseId.fill(0);
+
+    attributes.sensorExpRange[0].min = m_minExposure;
+    attributes.sensorExpRange[0].max = m_maxExposure;
+
+    attributes.sensorGainRange[0].min = GainMin();
+    attributes.sensorGainRange[0].max = SENSOR_GAIN_MAX;
+
+    attributes.sensorWhiteBalanceRange[0].min = 1.0f;
+    attributes.sensorWhiteBalanceRange[0].max = 4.0f;
+
+    attributes.sensorGainFactor[0] = 1.0f;
+
+    return true;
+}
+
+float IMX900SensorDriver::GainMin() const {
+    return (m_conversionGain == ConversionGain::High) ? SENSOR_GAIN_MIN_HCG : SENSOR_GAIN_MIN;
+}
+
+bool IMX900SensorDriver::SetGain(uddf::cdi::IHardwareAccess& hwAccess,
+                                 uddf::cdi::IDriverServices& driverServices,
+                                 const sensor_control::ExposureGainInfo& exposureGainControl){
+
+    if (!(exposureGainControl.sensorGain && exposureGainControl.sensorGain->count > 0U)) {
+        log(" exposureGainControl[0].sensorGain is not set");
+        return false;
+    }
+
+    logDebug("  exposureGainControl[0].sensorGain[0]=",
+        exposureGainControl.sensorGain->data[0],
+        " (count=", exposureGainControl.sensorGain->count, ")");
+    float gain = exposureGainControl.sensorGain->data[0];
+    logDebug("  gain=", gain);
+
+    const float gainMin = GainMin();
+    if (gain < gainMin) {
+        log("  WARNING: requested gain ", gain,
+            " is below minimum ", gainMin,
+            ", clamping to minimum");
+    } else if (gain > SENSOR_GAIN_MAX) {
+        log("  WARNING: requested gain ", gain,
+            " is above maximum ", SENSOR_GAIN_MAX,
+            ", clamping to maximum");
+    }
+    gain = std::clamp(gain, gainMin, SENSOR_GAIN_MAX);
+    logDebug("  gain=", gain);
+
+    uint16_t gain_reg = static_cast<uint16_t>(std::round(GAIN_DB_SCALE * std::log10(gain)));
+    logDebug("  gain_reg=", gain_reg, " (0x", std::hex, gain_reg, std::dec, ")");
+    const uint16_t gainRegMin = (m_conversionGain == ConversionGain::High)
+        ? static_cast<uint16_t>(fr_imx900::hsl::GAIN_REG_MIN_HCG) : static_cast<uint16_t>(0U);
+    gain_reg = std::clamp(gain_reg, gainRegMin, GAIN_REG_MAX);
+
+    fr_imx900::hsl::gain_register gainReg{};
+    gainReg.gain[0] = static_cast<uint8_t>(gain_reg & 0xFFU);
+    gainReg.gain[1] = static_cast<uint8_t>((gain_reg >> 8U) & 0x01U);
+
+    logDebug("  gain_reg = ", gain_reg, " gain_reg 0 =", static_cast<unsigned>(gainReg.gain[0]),
+             " gain_reg 1 =", static_cast<unsigned>(gainReg.gain[1]));
+
+    hwAccess.SubmitSequence(fr_imx900::hsl::set_gain, gainReg);
+
+    return true;
+}
+
+bool IMX900SensorDriver::SetExposure(uddf::cdi::IHardwareAccess& hwAccess,
+                                     uddf::cdi::IDriverServices& driverServices,
+                                     const sensor_control::ExposureGainInfo& exposureGainControl){
+
+    if (!(exposureGainControl.exposureTime && exposureGainControl.exposureTime->count > 0U)) {
+        log("  exposureGainControl[0].exposureTime is not set");
+        return false;
+    }
+
+    logDebug("  exposureGainControl[0].exposureTime[0]=",
+        exposureGainControl.exposureTime->data[0],
+        " s (count=", exposureGainControl.exposureTime->count, ")");
+
+    float exposure_time = exposureGainControl.exposureTime->data[0];
+    logDebug("  exposure_time=", exposure_time, " s");
+
+    if (!std::isfinite(exposure_time) || exposure_time <= 0.0f) {
+        log("  WARNING: invalid exposure time ", exposure_time, " s, ignoring");
+        return false;
+    }
+
+    int64_t integration_line = static_cast<int64_t>(exposure_time / (m_lineTimeNs * 1e-9f));
+
+    int64_t shs_reg = m_vmax - integration_line;
+    logDebug("  shs_reg=", shs_reg, " (0x", std::hex, shs_reg, std::dec, ")");
+    if (shs_reg < static_cast<int64_t>(m_minShs)) {
+        log("  WARNING: shs_reg ", shs_reg,
+            " is below minimum ", m_minShs,
+            ", clamping to minimum");
+        shs_reg = m_minShs;
+    } else if (shs_reg > m_vmax - 1) {
+        log("  WARNING: shs_reg ", shs_reg,
+            " is above maximum ", m_vmax - 1,
+            ", clamping to maximum");
+        shs_reg = m_vmax - 1;
+    }
+    logDebug("  shs_reg=", shs_reg, " (0x", std::hex, shs_reg, std::dec, ")");
+
+    uint32_t exposure_reg = static_cast<uint32_t>(shs_reg);
+    logDebug("  exposure_reg=", exposure_reg, " (0x", std::hex, exposure_reg, std::dec, ")");
+
+    fr_imx900::hsl::exposure_register expReg{};
+    expReg.exposure[0] = static_cast<uint8_t>(exposure_reg & 0xFFU);
+    expReg.exposure[1] = static_cast<uint8_t>((exposure_reg >> 8U) & 0xFFU);
+    expReg.exposure[2] = static_cast<uint8_t>((exposure_reg >> 16U) & 0xFFU);
+
+    logDebug("  exposure_reg = ", exposure_reg,
+        " exposure_reg 0 =", static_cast<unsigned>(expReg.exposure[0]),
+        " exposure_reg 1 =", static_cast<unsigned>(expReg.exposure[1]),
+        " exposure_reg 2 =", static_cast<unsigned>(expReg.exposure[2]));
+
+    hwAccess.SubmitSequence(fr_imx900::hsl::set_exposure, expReg);
+
+    return true;
+}
+
+bool IMX900SensorDriver::SetSensorControls(uddf::cdi::IHardwareAccess& hwAccess,
+                                            uddf::cdi::IDriverServices& driverServices,
+                                            const SensorControls& controls) {
+    logDebug("SetSensorControls called - IMX900 Sensor Driver");
+    bool result = true;
+
+    logDebug("setting controls");
+
+    // One REGHOLD bracket around both writes rather than one each: on the CoE
+    // path every I2C transaction is a round trip to the HSB, so the bracket
+    // costs as much as the data it protects.
+    hwAccess.SubmitSequence(fr_imx900::hsl::reghold_on);
+
+    if (!SetExposure(hwAccess, driverServices, controls.exposureGainControl[0])) {
+        log("SetExposure failed");
+        result = false;
+    }
+
+    if (!SetGain(hwAccess, driverServices, controls.exposureGainControl[0])) {
+        log("SetGain failed");
+        result = false;
+    }
+
+    hwAccess.SubmitSequence(fr_imx900::hsl::reghold_off);
+
+    return result;
+}
+
+bool IMX900SensorDriver::ParseTopEmbeddedData(uddf::cdi::IDriverServices& driverServices,
+                                               const EmbeddedDataChunk& chunk,
+                                               EmbeddedDataInfo& info) {
+    logDebug("ParseTopEmbeddedData called - Chunk lineLength: ", chunk.lineLength, " bytes");
+
+    uint32_t gain_reg = chunk.lineData[51] + 256 * (chunk.lineData[49] % 2);
+    uint32_t shs_reg = chunk.lineData[19] + 256 * chunk.lineData[18] + 65536 * chunk.lineData[16];
+
+    logDebug("  gain reg=", gain_reg, " (0x", std::hex, gain_reg, std::dec,
+        ") exposure reg=", shs_reg, " (0x", std::hex, shs_reg, std::dec,
+        ") VMAX=", m_vmax, " (0x", std::hex, m_vmax, std::dec, ")");
+
+    float gain_time = std::pow(10.0f, static_cast<float>(gain_reg) / GAIN_DB_SCALE);
+
+    if (gain_time > SENSOR_GAIN_MAX) {
+        gain_time = SENSOR_GAIN_MAX;
+        log("gain value too large, setting to maximal gain_time=", gain_time);
+    } else if (gain_time < SENSOR_GAIN_MIN) {
+        gain_time = SENSOR_GAIN_MIN;
+        log("gain value too small, setting to minimal gain_time=", gain_time);
+    }
+
+    int64_t integration_line = m_vmax - shs_reg;
+    logDebug("  integration line =", integration_line);
+
+    if (integration_line < 2) {
+        logDebug("  integration line too small, setting to 1");
+        integration_line = 2;
+    } else if (integration_line > static_cast<int64_t>(m_vmax - m_minShs)) {
+        logDebug("  integration line too large, setting to VMAX - MIN_SHS");
+        integration_line = m_vmax - m_minShs;
+    }
+
+    float exposure = integration_line * m_lineTimeNs * 1e-9f;
+    logDebug("  exposure = ", exposure);
+
+    if (exposure < m_minExposure) {
+        log(" exposure out of range setting to m_minExposure ", m_minExposure);
+        exposure = m_minExposure;
+    } else if (exposure > m_maxExposure) {
+        log(" exposure out of range setting to MAX_EXPOSURE ", m_maxExposure);
+        exposure = m_maxExposure;
+    }
+
+    info.numExposures = 1U;
+
+    info.exposureGainInfo = uddf::ddi::interfaces::sensor_control::ExposureGainInfo {
+            .exposureTime = uddf::ddi::interfaces::sensor_control::ExposureGainInfo::ExposureArray {
+                .count = 1U,
+                .data = {{exposure}}
+            },
+            .sensorGain = uddf::ddi::interfaces::sensor_control::ExposureGainInfo::GainArray {
+                .count = 1U,
+                .data = {{gain_time}}
+            }
+    };
+
+    info.sensorWBGainInfo = uddf::ddi::interfaces::sensor_control::SensorControls::WbGainArray {
+            .count = 1U,
+            .data = {{{{ 1.0f, 1.0f, 1.0f, 1.0f }}}}
+        };
+
+    info.sensorTempData = uddf::ddi::interfaces::sensor_control::SensorTempData {
+        .numTemperatures = 1U,
+        .sensorTempCelsius = {{22.0}}
+    };
+
+    info.frameSequenceNumber = m_artificialFrameCounter++;
+
+    return true;
+}
+
+bool IMX900SensorDriver::ParseBottomEmbeddedData(uddf::cdi::IDriverServices& driverServices,
+                                                  const EmbeddedDataChunk& chunk,
+                                                  EmbeddedDataInfo& info) {
+    logDebug("ParseBottomEmbeddedData called - Chunk lineLength: ", chunk.lineLength, " bytes");
+    return true;
+}
+
+} // namespace uddf::samples
